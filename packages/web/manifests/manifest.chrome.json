{
  "manifest_version": 3,
  "name": "Keetar (dev build)",
  "version": "0.1.0",
  "description": "A TypeScript-native KeePass-compatible browser extension. No desktop app required.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["storage", "idle", "alarms", "clipboardWrite", "tabs"]
}
