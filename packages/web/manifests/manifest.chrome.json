{
  "manifest_version": 3,
  "name": "Keetar",
  "version": "0.1.0",
  "description": "A TypeScript-native KeePass-compatible browser extension. No desktop app required.",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/keetar-16.png",
    "32": "icons/keetar-32.png",
    "48": "icons/keetar-48.png",
    "128": "icons/keetar-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/keetar-16.png",
      "32": "icons/keetar-32.png",
      "48": "icons/keetar-48.png",
      "128": "icons/keetar-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/keetar-32.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["storage", "idle", "alarms", "clipboardWrite", "tabs", "identity"]
}
