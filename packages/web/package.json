{
  "name": "@keetar/web",
  "version": "0.1.0",
  "description": "A browser extension that brings native KeePass vault management to Chrome and Firefox — no desktop app required.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && webpack --config build/webpack.config.js --mode production",
    "build:dev": "pnpm run clean && webpack --config build/webpack.config.js --mode development",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@keetar/core": "workspace:*",
    "argon2-browser": "^1.18.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tldts": "^6.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "copy-webpack-plugin": "^12.0.0",
    "rimraf": "^6.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "~5.9.0",
    "vitest": "^2.1.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^6.0.0"
  }
}
